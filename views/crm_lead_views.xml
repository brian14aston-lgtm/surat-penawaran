<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_surat_penawaran" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.surat.penawaran</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Action Buttons on Header (Header Form CRM) -->
            <xpath expr="//header" position="inside">
                <button name="action_create_surat_penawaran" type="object"
                        string="📄 Buat Penawaran" class="btn-primary"/>
                <button name="action_create_customer_po" type="object"
                        string="🛒 Buat Form PO" class="btn-secondary"/>
            </xpath>

            <!-- Smart Buttons for Surat Penawaran & Customer PO -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_surat_penawaran" icon="fa-file-text-o">
                    <field name="surat_penawaran_count" widget="statinfo" string="Penawaran"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_customer_po" icon="fa-shopping-cart">
                    <field name="customer_po_count" widget="statinfo" string="Form PO"/>
                </button>
            </xpath>
            <!-- Tab Detail Penawaran & PO di Notebook CRM -->
            <xpath expr="//notebook" position="inside">
                <page string="Surat Penawaran" name="surat_penawaran_page">
                    <field name="surat_penawaran_ids" readonly="1">
                        <tree string="Daftar Surat Penawaran">
                            <field name="name" string="Nomor Surat"/>
                            <field name="date_order" string="Tanggal"/>
                            <field name="validity_date" string="Berlaku Sampai"/>
                            <field name="pic_name" string="PIC"/>
                            <field name="amount_total" string="Total" widget="monetary"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'sent'"
                                   decoration-success="state == 'accepted'"
                                   decoration-danger="state == 'refused'"/>
                        </tree>
                    </field>
                </page>
                <page string="Purchase Order (PO)" name="customer_po_page">
                    <field name="customer_po_ids" readonly="1">
                        <tree string="Daftar Form Purchase Order">
                            <field name="name" string="Nomor PO"/>
                            <field name="date_order" string="Tanggal PO"/>
                            <field name="signer_name" string="Penandatangan / PIC"/>
                            <field name="signer_job" string="Jabatan"/>
                            <field name="amount_total" string="Total Nilai" widget="monetary"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state == 'confirmed'"
                                   decoration-danger="state == 'cancel'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
